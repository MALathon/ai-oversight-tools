{
  "$schema": "../schemas/phases.schema.json",
  "version": "2.0.0",
  "source": "Three-Stage IRB Review Framework (Eto, Lifson & Vidal)",
  "lastUpdated": "2026-03-15",
  "stages": [
    {
      "id": "stage-1",
      "number": 1,
      "name": "Discovery & Ideation",
      "shortName": "Discovery",
      "description": "Teaching and training the system. AI is learning from data but is not providing advice or making decisions. Uses retrospective or secondary-use data.",
      "characteristics": [
        "Retrospective or synthetic data use",
        "No real-world deployment",
        "Algorithm training and initial testing",
        "De-identification of training data",
        "Bias analysis on retrospective datasets"
      ],
      "typicalOversight": "Minimal to Standard IRB review",
      "keyFocus": [
        "Data governance",
        "Privacy protections",
        "Bias identification",
        "Documentation of limitations"
      ]
    },
    {
      "id": "stage-2",
      "number": 2,
      "name": "Analytic & Performance Validation",
      "shortName": "Validation",
      "description": "Evaluating system behavior. AI produces outputs that are tested and reviewed, not used in real situations.",
      "characteristics": [
        "Prospective data collection possible",
        "Reviewer assessment of outputs (not for decisions)",
        "Formal testing and auditing protocols",
        "Shadow mode or parallel testing",
        "Subgroup performance evaluation"
      ],
      "typicalOversight": "Standard to Enhanced IRB review",
      "keyFocus": [
        "Performance validation",
        "Fairness testing across subgroups",
        "Human oversight protocols",
        "User feedback collection"
      ]
    },
    {
      "id": "stage-3",
      "number": 3,
      "name": "Real-World Deployment",
      "shortName": "Deployment",
      "description": "AI is used in real settings and its outputs influence decisions and outcomes. Highest level of oversight required.",
      "characteristics": [
        "Integration into operational workflows",
        "User training on AI use",
        "Staged rollout with monitoring",
        "Real-time safety monitoring",
        "Incident reporting systems"
      ],
      "typicalOversight": "Enhanced to Full IRB review",
      "keyFocus": [
        "Participant safety",
        "Human-in-the-loop requirements",
        "Ongoing performance monitoring",
        "Adverse event reporting",
        "Regulatory compliance"
      ]
    }
  ]
}
